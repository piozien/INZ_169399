PORT=8080
BACKEND_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# --- Database Configuration ---
POSTGRES_DB=samorzad
POSTGRES_USER=samorzad
POSTGRES_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/samorzad
SPRING_DATASOURCE_USERNAME=samorzad
SPRING_DATASOURCE_PASSWORD=change_me

# --- Security (JWT) ---
JWT_SECRET=insert_your_base64_secret_here
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000
JWT_ACTIVATION_EXPIRATION=86400000

# --- Password Reset ---
PASSWORD_RESET_EXPIRATION_HOURS=24

# --- OAuth2 Microsoft (User Login) ---
# Azure Portal -> App Registrations
OAUTH2_MICROSOFT_CLIENT_ID=your-client-id-here
OAUTH2_MICROSOFT_CLIENT_SECRET=your-client-secret-here
AZURE_TENANT_ID=your-tenant-id-here
OAUTH2_MICROSOFT_SCOPE=openid,profile,email,offline_access,https://graph.microsoft.com/Calendars.ReadWrite
OAUTH2_MICROSOFT_GRANT_TYPE=authorization_code
OAUTH2_MICROSOFT_REDIRECT_URI=http://localhost:8080/login/oauth2/code/microsoft
# Replace {your-tenant-id-here} with your ID
OAUTH2_MICROSOFT_ISSUER_URI=https://login.microsoftonline.com/your-tenant-id-here/v2.0
OAUTH2_MICROSOFT_TOKEN_URI=https://login.microsoftonline.com/your-tenant-id-here/v2.0/token
OAUTH2_MICROSOFT_USER_INFO_URI=https://graph.microsoft.com/oidc/userinfo
OAUTH2_MICROSOFT_USER_NAME_ATTRIBUTE=sub

# --- Microsoft Graph API (System) ---
MS_GRAPH_BASE_URL=https://graph.microsoft.com
MS_GRAPH_BASE_URL_01=https://graph.microsoft.com/v1.0
MS_CALENDAR_ENABLED=true
MS_CALENDAR_USE_SHARED_OWNER=false
MS_CALENDAR_OWNER_USER_ID=
MS_CALENDAR_EVENTS_PATH_ME=/me/events
MS_CALENDAR_EVENTS_PATH_USER=/users/{userId}/events
MS_GRAPH_CLIENT_ID=your-graph-client-id-here
MS_GRAPH_CLIENT_SECRET=your-graph-client-secret-here
MS_GRAPH_TENANT_ID=your-tenant-id-here
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default

# --- Azure Communication Services (Email) ---
# Data from the Communication Services resource in Azure
ACS_CONNECTION_STRING=Endpoint=https://your-resource.communication.azure.com/;AccessKey=your-access-key
ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net

# --- Scheduler ---
SCHEDULING_ENABLED=true

# --- Frontend Public Vars (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-client-id-here
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-tenant-id-here