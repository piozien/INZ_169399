# Dockerfile-dev - Development and Testing Environment
FROM openjdk:17-jdk-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    maven \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Maven files
COPY su_backend/pom.xml ./su_backend/
COPY su_backend/.mvn ./su_backend/.mvn
COPY su_backend/mvnw ./su_backend/

# Copy source code
COPY su_backend/src ./su_backend/src

# Set working directory to backend
WORKDIR /app/su_backend

# Download dependencies
RUN ./mvnw dependency:go-offline -B

# Expose ports
EXPOSE 8080 5005

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

# Default command - run tests
CMD ["./mvnw", "test"]
